[sub_resource type="GDScript" id="GDScript_atce0"]
resource_name = "spawner"
script/source = "#@tool
class_name SceneSpawner extends Area3D

## The packed scene name
var _scene_type: String = \"\"

## Scene to spawn
@export var scene: PackedScene
## The parent the scene will spawn under. Default is this spawner
@export var parent: Node3D = self
## Maximum amount of scene to spawn
@export_range(1, 100, 1) var max_amount: int = 10
## Track the amount of scene spawned
var _amount_spawned: int = 0
## Seconds before another spawn. 0 means instant.
@export_range(0.0, 60.0, 0.1, \"or_greater\") var delay: float = 0.0
@warning_ignore(\"unused_private_class_variable\")
#@export_tool_button(\"Manual spawn\", \"InputEventAction\") var _spawn_action: Callable = _spawn

var _timer: Timer = null
## when there is not timer, used to check every 20 frames for spawn
var _no_delay_count: int = 0

# TODO enum for the type of spawn technic used:
# - timer
# - signal
# and a parameter to setup if we free ourselves once done or reset timer
# maybe an array of scene with robability to spawn each one (class extending this one?)

func _ready() -> void:
	if Engine.is_editor_hint():
		return

	# if no scene setup, or can't instantiate, just remove itself
	if scene == null || !scene.can_instantiate():
		queue_free()
		return

	# get the type of the scene
	_get_scene_type()

	# setup timer if there is a delay
	if (delay > 0):
		_timer = Timer.new()
		add_child(_timer)
		_timer.timeout.connect(_check_for_spawn)
		_timer.start(delay)

	# spawn the first one
	_spawn.call_deferred()

func _process(_delta: float) -> void:
	if Engine.is_editor_hint():
		return

	# check every 20 frames for spawn
	_no_delay_count += 1
	if _no_delay_count == 20:
		_no_delay_count = 0
	else:
		return

	# stop checking if we reached our amount to spawn
	if _amount_spawned >= max_amount:
		_check_to_free()
		return

	if delay > 0:
		return

	_check_for_spawn()

func _get_scene_type() -> void:
	# get the root node of the scene
	var ancestry: Array[SceneState] = []
	var state: SceneState = scene.get_state()
	while state != null:
		ancestry.append(state)
		state = state.get_base_scene_state()
	var root: SceneState = ancestry.back()

	# now, check if the root has a script, if yes, get his name, if it has one
	for i: int in root.get_node_property_count(0):
		if root.get_node_property_name(0, i) == &\"script\":
			var script: Script = root.get_node_property_value(0, i)
			_scene_type = script.get_global_name()
			if not _scene_type.is_empty():
				return

	# the root has no script, or no named script, return it's base class
	_scene_type = root.get_node_type(0)

func _check_for_spawn() -> void:
	if _timer != null:
		if _amount_spawned < max_amount:
			_timer.start(delay)
		else:
			_timer.stop()

	# check for any overlapping bodies
	var has_overlapping: bool = false
	for body: Node3D in get_overlapping_bodies():
		# get script name, or node type
		var script: Script = body.get_script()
		var type: String = body.get_class()
		#print(\"body type: \" + type)
		#if script != null:
			#print(\"Body script name: \" + script.get_global_name())
		# if the script name or the type is the same, create new scene
		if (script != null and script.get_global_name() == _scene_type) or type == _scene_type:
			has_overlapping = true
			break

	if !has_overlapping:
		_spawn()

func _spawn() -> void:
	# stops when we reach the max_amount and has only the collision shape and timer
	if _amount_spawned >= max_amount:
		_check_to_free()
		return

	_amount_spawned += 1
	var new_scene: Node = scene.instantiate()
	parent.add_child(new_scene)

func _check_to_free()->void:
	if _amount_spawned < max_amount || is_queued_for_deletion():
		return

	if get_child_count() == 1 + (1 if _timer != null else 0):
		queue_free()
"

