{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "item",
    "title": "ItemSchema",
    "description": "The schema to define items.",
    "type": "object",
    "required": ["id", "display_name", "stack_size", "behaviors"],
    "additionalProperties": true,
    "properties": {
        "id": {
            "type": "string",
            "title": "The unique ID of this item's definition.",
            "minLength": 3,
            "maxLength": 31
        },
        "display_name": {
            "type": "string",
            "title": "The display name of this item.",
            "minLength": 3,
            "maxLength": 31
        },
        "stack_size": {
            "type": "number",
            "title": "The maximum amout this item can be stacked.",
            "minimum": 1,
            "multipleOf": 1,
            "default": 1
        },
        "behaviors": {
            "type": "array",
            "title": "A list of behaviors for this item.",
            "items": {
                "$ref": "#/$defs/behavior",
                "type": "object",
                "title": "The behavior of an item",
                "required": ["name"],
                "additionalProperties": true,
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "The unique identifier of this item's behavior",
                        "minLength": 3,
                        "maxLength": 31
                    }
                }
            }
        }
    },
    "$defs": {
        "behavior": {
            "type": "object",
            "title": "The behavior of an item",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
                "name": {
                    "type": "string",
                    "title": "The unique identifier of this item's behavior",
                    "minLength": 3,
                    "maxLength": 31
                }
            }
        }
    }
}
