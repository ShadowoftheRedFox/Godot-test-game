{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "building",
    "title": "BuildingSchema",
    "description": "The schema to define buildings.",
    "type": "object",
    "required": ["id", "display_name", "behaviors", "recipes"],
    "additionalProperties": true,
    "properties": {
        "id": {
            "type": "string",
            "title": "The unique ID of this building's definition.",
            "minLength": 3,
            "maxLength": 31
        },
        "display_name": {
            "type": "string",
            "title": "The display name of this building.",
            "minLength": 3,
            "maxLength": 31
        },
        "category": {
            "type": "string",
            "title": "The category of the building. Must be a key of \"BuildingDefinition.Category\"."
        },
        "group": {
            "type": "string",
            "title": "The group of the building inside its category.",
            "minLength": 3,
            "maxLength": 31
        },
        "behaviors": {
            "type": "array",
            "title": "A list of behaviors for this building.",
            "items": {
                "$ref": "#/$defs/behavior",
                "type": "object",
                "title": "The behavior of an building",
                "required": ["name"],
                "additionalProperties": true,
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "The unique identifier of this building's behavior",
                        "minLength": 3,
                        "maxLength": 31
                    }
                }
            }
        },
        "hidden": {
            "type": "boolean",
            "title": "Whether or not this building is hidden from the build menus, such as natural building that cannot be crafted.",
            "default": false
        },
        "recipes": {
            "type": "array",
            "title": "The list of recipes to place this building.",
            "items": {
                "$ref": "recipe.json"
            }
        }
    },
    "$defs": {
        "behavior": {
            "type": "object",
            "title": "The behavior of an building",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
                "name": {
                    "type": "string",
                    "title": "The unique identifier of this building's behavior",
                    "minLength": 3,
                    "maxLength": 31
                }
            }
        }
    }
}
